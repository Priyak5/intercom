# Copy to .env and fill in. Secrets live ONLY in the environment (CLAUDE.md I10).
# Every variable the app reads is listed here.

# --- core ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
# Comma-separated. localhost/127.0.0.1 are always allowed for the internal healthcheck.
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
BASE_URL=https://app.example.com
BASE_DOMAIN=example.com
# DATA_DIR defaults to <repo>/data locally and /app/data in Docker; override only if needed.
# DATA_DIR=/app/data
LOG_LEVEL=INFO

# --- process (I1: exactly one worker when background threads are on) ---
RUN_BACKGROUND_THREADS=1
UVICORN_WORKERS=1

# --- dashboard email / invites ---
# Console backend logs invite emails to stdout (Phase 1 default). In Phase 4 point this
# at the SMTP backend to actually deliver invites.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=support@example.com
INVITE_TTL_HOURS=168

# --- email channel (Phase 4) ---
MAIL_DOMAIN=example.com
# Sender identity on outbound replies. Defaults to DEFAULT_FROM_EMAIL if unset.
MAIL_FROM=support@example.com
# Route every inbound (not matched by In-Reply-To or plus-token) to this workspace id.
# Leave blank to use the first Workspace at poll time — POC single-workspace-per-deploy.
MAIL_WORKSPACE_ID=
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASS=your-app-password
IMAP_POLL_INTERVAL=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASS=your-app-password
# Seconds — must be short; the agent's reply request waits on this.
SMTP_TIMEOUT=8

# --- AI summarization (Phase 7) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
